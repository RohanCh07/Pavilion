# Copy to .env and fill in. Only TELEGRAM_BOT_TOKEN is required when DATA_PROVIDER=mock.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Data source, which also picks the sport:
#   api_football  football, real data (needs API_FOOTBALL_KEY)
#   mock          football, offline demo match
#   crex          cricket, scraped from crex.com public pages (no key)
#   mock_cricket  cricket, offline demo match
DATA_PROVIDER=api_football

# From https://dashboard.api-football.com (free plan: 100 requests/day)
API_FOOTBALL_KEY=

# Comma-separated API-Football league ids to follow (39 = Premier League, 140 = La Liga, 2 = Champions League)
LEAGUE_IDS=39

# crex only: comma-separated series keys to follow, the code at the end of a series URL
# (crex.com/series/india-tour-of-new-zealand-2026-2GR -> 2GR). Empty follows every match on
# CREX's home page.
CREX_SERIES=

# Season start year; leave empty to auto-detect (Aug-May seasons)
SEASON=

# Seconds between live polls while a tracked match is in progress
LIVE_POLL_SECONDS=120

# Seconds between refreshes of the day's fixture list
SCHEDULE_REFRESH_SECONDS=10800

# Scoring ruleset file name in src/fantasy_bot/scoring/rulesets (without .toml), or a path to
# your own. Empty picks the sport's default: dream11_football or dream11_cricket.
SCORING_RULESET=

# Max players per squad
SQUAD_SIZE=11

# SQLite by default; for Postgres use postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/fantasy.db

LOG_LEVEL=INFO

# --- Web API (python -m fantasy_bot.api); TELEGRAM_BOT_TOKEN isn't needed for it ---
# Locally 127.0.0.1:8000. On hosts that set PORT (Render, Railway...), it listens on 0.0.0.0:$PORT.
API_HOST=127.0.0.1
API_PORT=8000
# Front-end origins allowed to call the API, comma-separated
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Fantasy team size limits
TEAM_MIN_PLAYERS=1
TEAM_MAX_PLAYERS=11
# Built web app to serve at / (empty: web/dist in this project). Use API_HOST=0.0.0.0 to open
# it from a phone on the same Wi-Fi.
WEB_DIST=
